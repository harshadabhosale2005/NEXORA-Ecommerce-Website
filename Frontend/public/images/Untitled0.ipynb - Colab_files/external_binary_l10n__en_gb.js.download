var Hcc=class extends tq{constructor(a,b,c){super();this.notebook=a;this.cell=b;this.debugAdapter=c}createRequest(a,b,c){var d=this;return n(function*(){var e,f=yield(e=d.debugAdapter)==null?void 0:n0(e),g;e=new Map(f==null?void 0:(g=f.body)==null?void 0:g.variables.map(C=>[C.name,C]));if(b==="r"){if(SL){var h=vcc||(vcc=b0('["\\u003cctrl99\\u003esystem\\nYou are an expert software engineer and data scientist with expertise in R, Google Colaboratory and Jupyter notebooks. You will follow these rules strictly.\\n\\n- Use 2 spaces for indentation\\n- Given ### Preceding code, and ### Task, respond with code that works with Google Colaboratory or Jupyter Notebooks only\\n- Use only the ### Preceding code that is provided immediately before ### Task. Preceding code may be None\\n- Be sure to import libraries with library() if they are not imported in ### Context.\\n- You can install libraries with install.packages() if they are not installed in ### Context.\\n- If responding with plain text, make sure they are R comments.\\n- Preceding code may not always be relevant to the Task. If it is not relevant or is None, you must write code that does not have previous context. If it is relevant, write code with preceding code as context\\n- ### Code: should only contain valid R code, no markdown. Comments are allowed.\\u003cctrl100\\u003e","\\n\\n","\\u003cctrl99\\u003euser\\n### Preceding code:\\n[[preceding]]\\n### Task:\\n[[task]]\\n### Code:\\u003cctrl100\\u003e\\n\\u003cctrl99\\u003emodel\\n```r\\n[[answer]]\\n```\\u003cctrl100\\u003e",[null,null,512,["```"]]]'));
